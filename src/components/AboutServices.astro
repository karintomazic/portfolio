---
interface Stat {
  value: string;
  label: string;
}

interface Service {
  title: string;
  text: string;
  icon: string; // trusted SVG paths, rendered with set:html
}

const stats: Stat[] = [
  { value: '7+', label: 'years on the web' },
  { value: '5+', label: 'client projects' },
  { value: '2', label: 'own products' },
];

const services: Service[] = [
  {
    title: 'Frontend development',
    text: 'Responsive, maintainable interfaces with React, Next.js and TypeScript.',
    icon: '<path d="m8 9-4 3 4 3M16 9l4 3-4 3M13.5 6l-3 12"/>',
  },
  {
    title: 'Testing & accessibility',
    text: 'Storybook, Vitest, React Testing Library and Playwright.',
    icon: '<path d="M12 3 5 6v5c0 4.5 3 8 7 10 4-2 7-5.5 7-10V6l-7-3Z"/><path d="m9 12 2 2 4-4"/>',
  },
  {
    title: 'AI-assisted development',
    text: 'Claude and Codex for speed; my time goes to architecture and review.',
    icon: '<path d="M12 3c.5 4.5 2.5 6.5 7 7-4.5.5-6.5 2.5-7 7-.5-4.5-2.5-6.5-7-7 4.5-.5 6.5-2.5 7-7Z"/>',
  },
];
---

<section
  id="about"
  aria-labelledby="about-heading"
  class="mx-auto grid max-w-6xl gap-6 px-4 pb-24 md:grid-cols-[1.1fr_1fr]"
>
  <div class="rounded-[2rem] bg-surface p-8 sm:p-10">
    <p class="text-xs font-semibold tracking-[0.2em] text-accent uppercase">
      About me
    </p>
    <h2
      id="about-heading"
      class="mt-3 font-serif text-3xl text-balance text-primary"
    >
      Seven years of client work. Now building AI-first.
    </h2>
    <p class="mt-5 leading-relaxed text-ink-muted">
      I've spent over seven years building websites at agencies, first with
      WordPress, then with Drupal for enterprise clients. Today I work with
      React, Next.js and TypeScript: I design the system, direct AI agents to
      build it, and rely on tests to keep the output honest.
    </p>
    <dl class="mt-8 grid grid-cols-3 gap-4">
      {stats.map((stat) => (
        // flex-col-reverse shows the number on top, while the HTML keeps
        // the required order: <dt> (label) before <dd> (value)
        <div class="flex flex-col-reverse">
          <dt class="text-sm text-ink-muted">{stat.label}</dt>
          <dd class="font-serif text-4xl text-primary">{stat.value}</dd>
        </div>
      ))}
    </dl>
  </div>

  <ul class="grid gap-4">
    {services.map((service) => (
      <li class="flex gap-5 rounded-[2rem] border border-white/70 bg-white/60 p-6 backdrop-blur">
        <span class="grid size-12 shrink-0 place-items-center rounded-2xl bg-primary text-canvas">
          <svg
            aria-hidden="true"
            focusable="false"
            class="size-6"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            set:html={service.icon}
          />
        </span>
        <div>
          <h3 class="font-serif text-xl text-primary">{service.title}</h3>
          <p class="mt-1 text-sm text-ink-muted">{service.text}</p>
        </div>
      </li>
    ))}
  </ul>
</section>
