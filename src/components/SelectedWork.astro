---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import SectionHeading from './SectionHeading.astro';
import tattoobyjs from '../assets/projects/tattoobyjs.png';
import movieApp from '../assets/projects/react-onboarding-nextjs.png';
import iobi from '../assets/projects/iobi.png';
import ArrowIcon from './ArrowIcon.astro';

interface Project {
  slug: string;
  title: string;
  description: string;
  image: ImageMetadata;
  imageAlt: string;
  tags: string[];
  status: 'Live client project' | 'Coming soon' | 'Onboarding project';
}

const projects: Project[] = [
  {
    slug: 'tattoobyjs',
    title: 'tattoobyjs',
    description:
      'Website for a tattoo artist client in Maribor, with a portfolio, aftercare products and booking info.',
    image: tattoobyjs,
    imageAlt:
      'tattoobyjs home page with a large tattoo photo and the studio name',
    tags: ['Next.js', 'PocketBase', 'Tailwind CSS', 'Docker'],
    status: 'Live client project',
  },
  {
    slug: 'react-onboarding-nextjs',
    title: 'Movie database app',
    description:
      'TMDB-powered app with search, authentication and a documented, tested component library.',
    image: movieApp,
    imageAlt: 'Movie app showing a list of popular movies with posters',
    tags: ['Next.js', 'TypeScript', 'Auth.js', 'Storybook', 'Vitest'],
    status: 'Onboarding project',
  },
  {
    slug: 'iobi',
    title: 'iobi',
    description:
      'Multilingual catalogue for a family business making handcrafted concrete garden products.',
    image: iobi,
    imageAlt:
      'iobi home page with a heading about concrete products and photos of garden statues',
    tags: ['Next.js', 'PocketBase', 'Tailwind CSS', 'i18n'],
    status: 'Coming soon',
  },
];
---

<section aria-labelledby="work-heading">
  <div class="mx-auto max-w-6xl px-4 py-20 md:py-28">
    <div class="flex flex-wrap items-end justify-between gap-6">
      <SectionHeading id="work-heading" eyebrow="Selected work" title="Things I've built" />
      <a href="/projects" class="group inline-flex items-center gap-2 font-medium text-primary">
        <span class="underline decoration-decor underline-offset-4 transition-colors group-hover:decoration-primary">
          View all projects
        </span>
        <ArrowIcon class="transition-transform motion-safe:group-hover:translate-x-1" />
      </a>
    </div>

    <ol class="mt-12 border-b border-decor">
      {
        projects.map((project, index) => (
          <li class="group relative grid gap-6 border-t border-decor py-10 md:grid-cols-[3rem_6fr_5fr] md:items-center md:gap-10 has-[a:focus-visible]:outline-2 has-[a:focus-visible]:outline-offset-4 has-[a:focus-visible]:outline-primary">
            <span aria-hidden="true" class="font-serif text-2xl text-accent md:self-start md:pt-1">
              {String(index + 1).padStart(2, '0')}
            </span>

            <div>
              <p class="text-xs font-medium tracking-[0.2em] text-accent uppercase">{project.status}</p>
              <h3 class="mt-2 flex items-center gap-4 font-serif text-3xl text-primary">
                <a href={`/projects/${project.slug}`} class="outline-none after:absolute after:inset-0">
                  {project.title}
                </a>
                <span
                  aria-hidden="true"
                  class="grid size-10 place-items-center rounded-full border border-decor transition-colors group-hover:border-primary group-hover:bg-primary group-hover:text-canvas"
                >
                  <ArrowIcon />
                </span>
              </h3>
              <p class="mt-3 max-w-xl text-lg leading-relaxed text-ink-muted">{project.description}</p>
              <ul aria-label="Technologies" class="mt-5 flex flex-wrap gap-2">
                {project.tags.map((tag) => (
                  <li class="rounded-full border border-decor px-3 py-1 text-sm text-ink-muted">{tag}</li>
                ))}
              </ul>
            </div>

            <div class="overflow-hidden rounded-2xl shadow-lg ring-1 shadow-primary/10 ring-decor/40">
              <Image
                src={project.image}
                alt={project.imageAlt}
                widths={[480, 960]}
                sizes="(min-width: 768px) 460px, 100vw"
                class="aspect-[16/10] w-full object-cover object-top transition-transform duration-500 motion-safe:group-hover:scale-105"
              />
            </div>
          </li>
        ))
      }
    </ol>
  </div>
</section>

