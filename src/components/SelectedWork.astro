---
import { getProjects } from '../data/projects';
import ArrowIcon from './ArrowIcon.astro';
import ProjectCard from './ProjectCard.astro';

const projects = (await getProjects()).slice(0, 3);
---

<section
  id="work"
  aria-labelledby="work-heading"
  class="mx-auto max-w-6xl px-4 py-24"
>
  <div class="flex flex-wrap items-end justify-between gap-6">
    <div>
      <p
        data-reveal
        class="text-xs font-semibold tracking-[0.2em] text-accent uppercase"
      >
        Selected work
      </p>
      <h2
        id="work-heading"
        data-reveal
        class="mt-3 max-w-md font-serif text-4xl text-balance text-primary"
      >
        Building interfaces that people enjoy using
      </h2>
    </div>
    <a
      data-reveal
      href="/projects"
      class="group inline-flex items-center gap-2 py-2 font-medium text-primary underline-offset-8 hover:underline"
    >
      View all projects
      <ArrowIcon class="transition-transform motion-safe:group-hover:translate-x-0.5" />
    </a>
  </div>

  <ul class="mt-12 grid gap-6 md:grid-cols-3">
    {projects.map((project, index) => (
      // The <li> fades in on scroll (data-reveal); the card inside tilts and
      // lights up under the cursor. Separate elements, so the effects don't clash.
      <li data-reveal style={`--i: ${index}`}>
        <ProjectCard project={project} />
      </li>
    ))}
  </ul>
</section>
