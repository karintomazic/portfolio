---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import tattoobyjs from '../assets/projects/tattoobyjs.png';
import movieApp from '../assets/projects/react-onboarding-nextjs.png';
import iobi from '../assets/projects/iobi.png';
import ArrowIcon from './ArrowIcon.astro';

interface Project {
  slug: string;
  title: string;
  summary: string;
  image: ImageMetadata;
  imageAlt: string;
  badge: 'Client project' | 'Web app' | 'Coming soon';
  panel: 'bg-surface' | 'bg-surface-alt'; // background behind the screenshot
}

const projects: Project[] = [
  {
    slug: 'tattoobyjs',
    title: 'tattoobyjs',
    summary: 'Tattoo studio website',
    image: tattoobyjs,
    imageAlt:
      'tattoobyjs home page with a large tattoo photo and the studio name',
    badge: 'Client project',
    panel: 'bg-surface-alt',
  },
  {
    slug: 'react-onboarding-nextjs',
    title: 'Movie database app',
    summary: 'Next.js, Auth.js, Storybook',
    image: movieApp,
    imageAlt: 'Movie app showing a list of popular movies with posters',
    badge: 'Web app',
    panel: 'bg-surface',
  },
  {
    slug: 'iobi',
    title: 'iobi',
    summary: 'Multilingual product catalogue',
    image: iobi,
    imageAlt:
      'iobi home page with a heading about concrete products and photos of garden statues',
    badge: 'Coming soon',
    panel: 'bg-surface-alt',
  },
];
---

<section
  id="work"
  aria-labelledby="work-heading"
  class="mx-auto max-w-6xl px-4 py-24"
>
  <p class="text-xs font-semibold tracking-[0.2em] text-accent uppercase">
    Selected work
  </p>
  <h2
    id="work-heading"
    class="mt-3 max-w-md font-serif text-4xl text-balance text-primary"
  >
    Building interfaces that people enjoy using
  </h2>

  <ul class="mt-12 grid gap-6 md:grid-cols-3">
    {projects.map((project) => (
      <li class="group relative rounded-[2rem] border border-white/70 bg-white/60 p-3 shadow-sm backdrop-blur transition-shadow hover:shadow-xl hover:shadow-primary/10 has-[a:focus-visible]:outline-2 has-[a:focus-visible]:outline-offset-4 has-[a:focus-visible]:outline-primary">
        <div class:list={['relative rounded-[1.5rem] p-5', project.panel]}>
          <Image
            src={project.image}
            alt={project.imageAlt}
            widths={[400, 800]}
            sizes="(min-width: 768px) 320px, 90vw"
            class="aspect-[16/11] w-full rounded-xl object-cover object-top shadow-lg motion-safe:transition-transform motion-safe:duration-300 motion-safe:group-hover:-translate-y-1"
          />
          <span class="absolute top-3 right-3 rounded-full bg-white/90 px-3 py-1 text-xs font-semibold text-ink">
            {project.badge}
          </span>
        </div>
        <div class="flex items-center justify-between gap-4 p-4">
          <div>
            <h3 class="font-serif text-xl text-primary">
              <!-- Stretched link: the ::after covers the whole card, so the card is clickable -->
              <a
                href={`/projects/${project.slug}`}
                class="after:absolute after:inset-0 after:rounded-[2rem] focus-visible:outline-none"
              >
                {project.title}
              </a>
            </h3>
            <p class="text-sm text-ink-muted">{project.summary}</p>
          </div>
          <span
            aria-hidden="true"
            class="grid size-10 shrink-0 place-items-center rounded-full border border-decor text-primary transition-colors group-hover:border-primary group-hover:bg-primary group-hover:text-canvas"
          >
            <ArrowIcon direction="up-right" />
          </span>
        </div>
      </li>
    ))}
  </ul>
</section>
