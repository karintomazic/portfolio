---
import { navLinks, socialLinks } from '../data/navigation';

const year = new Date().getFullYear();
---

<footer class="border-t border-sage/40">
  <div class="mx-auto grid max-w-6xl gap-10 px-4 py-12 md:grid-cols-[2fr_1fr_1fr]">
    <div>
      <a href="/" class="group inline-flex items-center gap-3 rounded-full">
        <span
          aria-hidden="true"
          class="grid size-11 place-items-center rounded-full border border-olive font-serif text-2xl text-olive transition-colors group-hover:bg-olive group-hover:text-cream"
        >
          K
        </span>
        <span class="font-serif text-lg text-ink">Karin Tomazic</span>
      </a>
      <p class="mt-4 max-w-xs text-sm leading-relaxed text-ink-muted">
        Frontend developer building accessible, well-tested interfaces with
        React, Next.js and TypeScript.
      </p>
    </div>

    <nav aria-label="Footer">
      <p class="text-xs font-medium tracking-[0.2em] text-ink-muted uppercase">
        Pages
      </p>
      <ul class="mt-4 space-y-2">
        {navLinks.map((link) => (
          <li>
            <a
              href={link.href}
              class="text-ink transition-colors hover:text-olive"
            >
              {link.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <div>
      <p
        id="footer-social"
        class="text-xs font-medium tracking-[0.2em] text-ink-muted uppercase"
      >
        Follow me
      </p>
      <ul aria-labelledby="footer-social" class="mt-4 space-y-2">
        {socialLinks.map((link) => (
          <li>
            <a
              href={link.href}
              class="text-ink transition-colors hover:text-olive"
            >
              {link.label}
            </a>
          </li>
        ))}
      </ul>
    </div>
  </div>

  <div class="border-t border-sage/40">
    <p class="mx-auto max-w-6xl px-4 py-6 text-sm text-ink-muted">
      © {year} Karin Tomazic · Built with Astro, TypeScript and Tailwind CSS
    </p>
  </div>
</footer>
