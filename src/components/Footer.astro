---
import { socialLinks } from '../data/navigation';
import SocialIcon from './SocialIcon.astro';

const year = new Date().getFullYear();
---

<footer class="border-t border-decor/40">
  <div class="mx-auto flex max-w-6xl flex-wrap items-center justify-between gap-4 px-4 pt-8 pb-4">
    <a href="/" class="group inline-flex items-center gap-2">
      <span
        aria-hidden="true"
        class="grid size-11 place-items-center rounded-full border border-primary font-serif text-2xl text-primary transition-colors group-hover:bg-primary group-hover:text-canvas"
      >
        K
      </span>
      <span class="font-serif text-lg text-ink">Karin Tomazic</span>
    </a>

    <ul aria-label="Social links" class="flex gap-3">
      {socialLinks.map((social) => (
        <li>
          <a
            href={social.href}
            title={social.label}
            class="grid size-11 place-items-center rounded-full border border-decor text-primary transition-colors hover:border-primary hover:bg-primary hover:text-canvas"
          >
            <SocialIcon name={social.icon} class="size-[18px]" />
            <span class="sr-only">{social.label}</span>
          </a>
        </li>
      ))}
    </ul>
  </div>

  <p class="mx-auto max-w-6xl px-4 pt-4 pb-8 text-center text-sm text-ink-muted">
    © {year} Karin Tomazic · Built with Astro, TypeScript and Tailwind CSS
  </p>
</footer>
