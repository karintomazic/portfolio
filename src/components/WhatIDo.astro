---
import SectionHeading from './SectionHeading.astro';

// Simple line icons (24×24). Decorative only, so hidden from screen readers.
const icons = {
  code: '<path d="m8 9-4 3 4 3M16 9l4 3-4 3M13.5 6l-3 12" />',
  check:
    '<path d="M12 3 5 6v5c0 4.5 3 8 7 10 4-2 7-5.5 7-10V6l-7-3Z" /><path d="m9 12 2 2 4-4" />',
  sparkle:
    '<path d="M12 3c.5 4.5 2.5 6.5 7 7-4.5.5-6.5 2.5-7 7-.5-4.5-2.5-6.5-7-7 4.5-.5 6.5-2.5 7-7Z" />',
};

interface Service {
  title: string;
  description: string;
  icon: keyof typeof icons;
}

const services: Service[] = [
  {
    title: 'Frontend development',
    description:
      "Responsive, maintainable interfaces with React, Next.js and TypeScript. I'm used to joining existing codebases and teams and being productive within days.",
    icon: 'code',
  },
  {
    title: 'Testing & accessibility',
    description:
      'Components built in isolation in Storybook and tested with Vitest, React Testing Library and Playwright. Semantic HTML, keyboard support and good contrast from the start.',
    icon: 'check',
  },
  {
    title: 'AI-assisted development',
    description:
      'I use Claude and Codex to move faster, and spend my time where it matters most: architecture, data models, API boundaries and reviewing every line that ships.',
    icon: 'sparkle',
  },
];
---

<section
  aria-labelledby="services-heading"
  class="mx-auto max-w-6xl px-4 pb-20 md:pb-28"
>
  <SectionHeading
    id="services-heading"
    eyebrow="What I do"
    title="How I can help your team"
  />

  <ul class="mt-12 grid gap-6 md:grid-cols-3">
    {services.map((service) => (
      <li class="rounded-3xl border border-sage/40 bg-white/70 p-8">
        <span
          aria-hidden="true"
          class="grid size-12 place-items-center rounded-full bg-sage-50 text-olive"
        >
          <svg
            width="24"
            height="24"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.5"
            stroke-linecap="round"
            stroke-linejoin="round"
            set:html={icons[service.icon]}
          />
        </span>
        <h3 class="mt-6 font-serif text-xl text-ink">{service.title}</h3>
        <p class="mt-3 leading-relaxed text-ink-muted">{service.description}</p>
      </li>
    ))}
  </ul>
</section>
