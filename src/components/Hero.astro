---
import { Image } from 'astro:assets';
import portrait from '../assets/karin.png';
import ArrowIcon from './ArrowIcon.astro';
---

<section
  aria-labelledby="hero-heading"
  class="mx-auto grid max-w-6xl items-center gap-16 px-4 pt-10 pb-24 md:grid-cols-2 md:gap-12 md:pt-16"
>
  <!-- Text -->
  <div>
    <h1 id="hero-heading" class="font-serif">
      <span class="block text-5xl text-ink sm:text-6xl">Hi, I'm</span>
      <!-- prettier-ignore -->
      <span class="mt-1 block text-5xl leading-[1.05] font-semibold text-balance text-primary sm:text-7xl">Karin Tomazic<span aria-hidden="true" class="text-accent">.</span></span>
    </h1>
    <p class="mt-6 text-lg font-medium text-ink">
      Frontend Developer
      <br />
      <span class="font-normal text-ink-muted">based in</span> Maribor,
      Slovenia.
    </p>
    <p class="mt-5 max-w-md leading-relaxed text-ink-muted">
      I build accessible, well-tested web interfaces with React, Next.js and
      TypeScript, and use AI coding agents to ship them faster without cutting
      corners.
    </p>

    <div class="mt-8 flex flex-wrap gap-3">
      <a
        href="/projects"
        class="group inline-flex items-center gap-2 rounded-full bg-primary px-6 py-3.5 font-medium text-canvas shadow-lg shadow-primary/20 transition-colors hover:bg-primary-dark"
      >
        View my work
        <ArrowIcon class="transition-transform motion-safe:group-hover:translate-x-0.5" />
      </a>
      <a
        href="/about"
        class="rounded-full border border-decor bg-white/70 px-6 py-3.5 font-medium text-primary backdrop-blur transition-colors hover:border-primary"
      >
        About me
      </a>
    </div>
  </div>

  <!-- Round photo with a glass "Available for work" card -->
  <div class="relative mx-auto w-full max-w-sm md:max-w-md">
    <div class="aspect-square overflow-hidden rounded-full bg-linear-to-br from-surface to-surface-alt shadow-2xl shadow-primary/10">
      <Image
        src={portrait}
        alt="Karin Tomazic smiling, wearing a dark turtleneck"
        widths={[400, 600, 800, 1200]}
        sizes="(min-width: 768px) 448px, 90vw"
        loading="eager"
        fetchpriority="high"
        class="size-full object-cover object-[50%_20%]"
      />
    </div>

    <div class="absolute right-0 -bottom-8 w-64 rounded-3xl border border-white/70 bg-white/70 p-5 shadow-xl backdrop-blur-xl sm:-right-6">
      <p class="flex items-center gap-2 text-sm font-semibold text-ink">
        <span aria-hidden="true" class="size-2 rounded-full bg-accent"></span>
        Available for work
      </p>
      <p class="mt-2 text-sm text-ink-muted">
        Open to remote roles,{' '}
        <strong class="font-semibold text-ink">full-time or contract</strong>.
      </p>
      <a
        href="/karin-tomazic-cv.pdf"
        class="group mt-4 flex items-center gap-3 border-t border-decor pt-4 text-sm font-semibold text-primary"
      >
        <span class="grid size-9 place-items-center rounded-full border border-decor transition-colors group-hover:bg-primary group-hover:text-canvas">
          <ArrowIcon direction="down" />
        </span>
        Download CV <span class="sr-only">(PDF)</span>
      </a>
    </div>
  </div>
</section>
