---
import { Image } from 'astro:assets';
import portrait from '../assets/karin.png';
import { socialLinks } from '../data/navigation';
import ArrowIcon from './ArrowIcon.astro';
---

<section
  aria-labelledby="hero-heading"
  class="mx-auto grid max-w-6xl items-center gap-12 px-4 pt-8 pb-20 md:grid-cols-2 md:pt-16"
>
  <!-- Text -->
  <div class="order-2 md:order-1">
    <p class="text-sm font-medium tracking-[0.2em] text-accent uppercase">
      Hello, I'm
    </p>
    <h1
      id="hero-heading"
      class="mt-3 font-serif text-5xl leading-[1.05] text-primary sm:text-6xl lg:text-7xl"
    >
      Karin Tomazic
    </h1>
    <p class="mt-4 text-xl text-ink">Frontend Developer</p>
    <p class="mt-6 max-w-md text-lg leading-relaxed text-ink-muted">
      I build accessible, well-tested web interfaces with React, Next.js and
      TypeScript, and use AI coding agents to ship them faster without cutting
      corners.
    </p>

    <div class="mt-8 flex flex-wrap gap-4">
      <a
        href="/projects"
        class="group inline-flex items-center gap-2 rounded-full bg-primary px-6 py-3 text-canvas transition-colors hover:bg-primary-dark"
      >
        View my work{' '}
        <ArrowIcon class="transition-transform motion-safe:group-hover:translate-x-0.5" />
      </a>
      <a
        href="/karin-tomazic-cv.pdf"
        class="rounded-full border border-primary px-6 py-3 text-primary transition-colors hover:bg-primary hover:text-canvas"
      >
        Download CV <span class="sr-only">(PDF)</span>
      </a>
    </div>

    <p
      id="connect-heading"
      class="mt-10 text-xs font-medium tracking-[0.2em] text-ink-muted uppercase"
    >
      Let's connect
    </p>
    <ul aria-labelledby="connect-heading" class="mt-3 flex gap-6">
      {socialLinks.map((social) => (
        <li>
          <a
            href={social.href}
            class="text-ink underline decoration-decor underline-offset-4 transition-colors hover:text-primary hover:decoration-primary"
          >
            {social.label}
          </a>
        </li>
      ))}
    </ul>
  </div>

  <!-- Photo -->
  <div class="relative order-1 mx-auto w-full max-w-sm md:order-2 md:max-w-md">
    <!-- Decorative arch behind the photo -->
    <div
      aria-hidden="true"
      class="absolute inset-0 translate-x-3 translate-y-3 rounded-t-full bg-decor/50"
    ></div>

    <!-- Photo on a light decor arch -->
    <div class="relative overflow-hidden rounded-t-full bg-surface">
      <Image
        src={portrait}
        alt="Karin Tomazic smiling, wearing a dark turtleneck"
        widths={[400, 600, 800, 1200]}
        sizes="(min-width: 768px) 448px, 90vw"
        loading="eager"
        fetchpriority="high"
        class="aspect-[4/5] w-full object-cover object-[50%_25%]"
      />
    </div>
    <!-- "Open to work" card, inspired by 03 -->
    <div class="absolute bottom-6 -left-2 rounded-2xl border border-white/60 bg-canvas/85 px-5 py-4 shadow-lg backdrop-blur-md sm:-left-8">
      <p class="flex items-center gap-2 text-sm font-medium text-ink">
        <span aria-hidden="true" class="size-2 rounded-full bg-primary"></span>
        Open to work
      </p>
      <p class="mt-1 text-sm text-ink-muted">Remote · full-time or contract</p>
    </div>
  </div>
</section>
