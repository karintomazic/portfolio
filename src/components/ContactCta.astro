---
const email = 'tomazickarin@gmail.com';
import ArrowIcon from './ArrowIcon.astro';
---

<section
  id="contact"
  aria-labelledby="contact-heading"
  class="mx-auto max-w-6xl px-4 py-20 md:py-28"
>
  <div class="relative overflow-hidden rounded-[2.5rem] bg-primary px-6 py-16 text-center sm:px-16 md:py-20">
    <!-- Decorative soft circles -->
    <div
      aria-hidden="true"
      class="absolute -top-24 -right-24 size-72 rounded-full bg-canvas/10"
    ></div>
    <div
      aria-hidden="true"
      class="absolute -bottom-32 -left-20 size-80 rounded-full bg-canvas/5"
    ></div>

    <div class="relative">
      <p class="text-sm font-medium tracking-[0.2em] text-canvas uppercase">
        Get in touch
      </p>
      <h2
        id="contact-heading"
        class="mx-auto mt-3 max-w-2xl font-serif text-3xl leading-tight text-canvas sm:text-5xl"
      >
        Let's build something together
      </h2>
      <p class="mx-auto mt-6 max-w-xl text-lg leading-relaxed text-canvas">
        I'm open to remote frontend or full-stack roles, full-time or contract.
        If you're building something with React, Next.js and TypeScript, I'd
        love to hear about it.
      </p>

      <div class="mt-10 flex flex-wrap items-center justify-center gap-4">
        <a
          href={`mailto:${email}`}
          class="group inline-flex items-center gap-2 rounded-full bg-canvas px-6 py-3 font-medium text-primary transition-colors hover:bg-white focus-visible:outline-canvas"
        >
          Let's talk{' '}
          <ArrowIcon class="transition-transform motion-safe:group-hover:translate-x-0.5" />
        </a>
        <a
          href="https://www.linkedin.com/in/karin-tomazic"
          class="rounded-full border border-canvas px-6 py-3 text-canvas transition-colors hover:bg-canvas/10 focus-visible:outline-canvas"
        >
          Connect on LinkedIn
        </a>
      </div>

      <p class="mt-8 text-canvas">
        or email me at{' '}
        <a
          href={`mailto:${email}`}
          class="underline underline-offset-4 focus-visible:outline-canvas"
        >
          {email}
        </a>
      </p>
    </div>
  </div>
</section>
