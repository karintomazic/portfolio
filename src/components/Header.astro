---
import { navLinks, socialLinks } from '../data/navigation';
import ArrowIcon from './ArrowIcon.astro';
import SocialIcon from './SocialIcon.astro';

// Current page, without a trailing slash, so we can highlight the active link
const currentPath = Astro.url.pathname.replace(/\/$/, '') || '/';
---

<header class="mx-auto max-w-6xl px-4 py-6">
  <nav aria-label="Main" class="flex items-center justify-between gap-4">
    <!-- Logo: K monogram + name, links to the home page -->
    <a href="/" class="group inline-flex items-center gap-2">
      <span
        aria-hidden="true"
        class="grid size-11 place-items-center rounded-full border border-primary font-serif text-2xl text-primary transition-colors group-hover:bg-primary group-hover:text-canvas"
      >
        K
      </span>
      <span class="font-serif text-lg text-ink">Karin Tomazic</span>
    </a>

    <!-- Desktop links -->
    <ul class="hidden items-center gap-8 md:flex">
      {navLinks.map((link) => (
        <li>
          <a
            href={link.href}
            aria-current={currentPath === link.href ? 'page' : undefined}
            class="block py-2 text-ink underline-offset-8 transition-colors hover:text-primary aria-[current=page]:text-primary aria-[current=page]:underline"
          >
            {link.label}
          </a>
        </li>
      ))}
      <li>
        <a
          href="/#contact"
          class="group inline-flex items-center gap-2 rounded-full bg-primary px-5 py-2.5 text-canvas transition-colors hover:bg-primary-dark"
        >
          Let's talk
          <ArrowIcon class="transition-transform motion-safe:group-hover:translate-x-0.5" />
        </a>
      </li>
    </ul>

    <!-- Menu button: only on small screens -->
    <button
      id="menu-toggle"
      type="button"
      aria-haspopup="dialog"
      aria-expanded="false"
      aria-controls="mobile-menu"
      class="grid size-11 place-items-center rounded-full border border-primary text-primary md:hidden"
    >
      <span class="sr-only">Menu</span>
      <svg
        aria-hidden="true"
        width="20"
        height="20"
        viewBox="0 0 20 20"
        fill="none"
        stroke="currentColor"
        stroke-width="1.5"
        stroke-linecap="round"
      >
        <path d="M3 6h14M3 10h14M3 14h14" />
      </svg>
    </button>
  </nav>

  <!-- Mobile menu: a drawer that slides in from the right -->
  <dialog
    id="mobile-menu"
    aria-labelledby="mobile-menu-title"
    class="m-0 ml-auto h-dvh max-h-none w-[86%] max-w-sm rounded-l-[2rem] bg-canvas p-0 shadow-2xl backdrop:bg-ink/45 motion-safe:transition-transform motion-safe:duration-300 motion-safe:starting:open:translate-x-full"
  >
    <div class="flex h-full flex-col p-6">
      <div class="flex items-center justify-between">
        <p
          id="mobile-menu-title"
          class="text-xs font-medium tracking-[0.2em] text-accent uppercase"
        >
          Menu
        </p>
        <button
          type="button"
          data-close-menu
          class="grid size-11 place-items-center rounded-full border border-primary text-primary"
        >
          <span class="sr-only">Close menu</span>
          <svg
            aria-hidden="true"
            width="20"
            height="20"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.75"
            stroke-linecap="round"
          >
            <path d="M6 6l12 12M18 6 6 18" />
          </svg>
        </button>
      </div>

      <nav aria-label="Main">
        <ul class="mt-10 border-t border-decor">
          {navLinks.map((link) => {
            const isCurrent = currentPath === link.href;
            return (
              <li class="border-b border-decor">
                <a
                  href={link.href}
                  aria-current={isCurrent ? 'page' : undefined}
                  class="flex items-center justify-between py-5 font-serif text-3xl text-primary"
                >
                  {link.label}
                  {isCurrent && (
                    <span
                      aria-hidden="true"
                      class="size-2 rounded-full bg-accent"
                    />
                  )}
                </a>
              </li>
            );
          })}
        </ul>
      </nav>

      <a
        href="/#contact"
        class="mt-8 flex items-center justify-center gap-2 rounded-full bg-primary py-4 font-medium text-canvas"
      >
        Let's talk <ArrowIcon />
      </a>

      <div class="mt-auto rounded-3xl bg-surface p-5">
        <p class="text-sm font-medium text-ink">Open to work</p>
        <p class="mt-1 text-sm text-ink-muted">
          Remote · full-time or contract
        </p>
        <ul class="mt-4 flex gap-3">
          {socialLinks.map((social) => (
            <li>
              <a
                href={social.href}
                class="grid size-11 place-items-center rounded-full border border-decor text-primary"
              >
                <SocialIcon name={social.icon} class="size-[18px]" />
                <span class="sr-only">{social.label}</span>
              </a>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </dialog>
</header>

<script>
  const button = document.querySelector<HTMLButtonElement>('#menu-toggle');
  const dialog = document.querySelector<HTMLDialogElement>('#mobile-menu');

  if (button && dialog) {
    button.addEventListener('click', () => {
      dialog.showModal();
      button.setAttribute('aria-expanded', 'true');
      document.documentElement.style.overflow = 'hidden'; // stop the page behind from scrolling
    });

    // Runs however the dialog closes: close button, Escape, a link or the backdrop
    dialog.addEventListener('close', () => {
      button.setAttribute('aria-expanded', 'false');
      document.documentElement.style.overflow = '';
    });

    dialog.addEventListener('click', (event) => {
      const target = event.target as HTMLElement;
      const clickedBackdrop = target === dialog;
      const clickedLinkOrClose = target.closest('a, [data-close-menu]');
      if (clickedBackdrop || clickedLinkOrClose) dialog.close();
    });
  }
</script>
