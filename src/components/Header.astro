---
import { navLinks, socialLinks } from '../data/navigation';
import ArrowIcon from './ArrowIcon.astro';
import Logo from './Logo.astro';
import SocialIcon from './SocialIcon.astro';

// Current page, without a trailing slash, so we can highlight the active link
const currentPath = Astro.url.pathname.replace(/\/$/, '') || '/';
---

<header class="mx-auto max-w-6xl px-4 py-6">
  <div class="flex items-center justify-between gap-4">
    <a href="/" class="py-2">
      <Logo />
      <span class="sr-only">, home</span>
    </a>

    <!-- Desktop links, in the middle -->
    <nav aria-label="Main" class="hidden md:block">
      <ul class="flex items-center gap-8 text-sm">
        {navLinks.map((link) => (
          <li>
            <a
              href={link.href}
              aria-current={currentPath === link.href ? 'page' : undefined}
              class="block py-2 text-ink underline-offset-8 transition-colors hover:text-primary aria-[current=page]:text-primary aria-[current=page]:underline"
            >
              {link.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <div class="flex items-center gap-3">
      <a
        href="/#contact"
        class="group hidden items-center gap-2 rounded-full border border-decor bg-white/70 px-5 py-2.5 text-sm font-medium text-primary backdrop-blur transition-colors hover:border-primary hover:bg-primary hover:text-canvas sm:inline-flex"
      >
        Let's talk
        <ArrowIcon
          direction="up-right"
          class="transition-transform motion-safe:group-hover:translate-x-0.5 motion-safe:group-hover:-translate-y-0.5"
        />
      </a>

      <!-- Menu button: only on small screens -->
      <button
        id="menu-toggle"
        type="button"
        aria-haspopup="dialog"
        aria-expanded="false"
        aria-controls="mobile-menu"
        class="grid size-11 place-items-center rounded-full border border-decor bg-white/70 text-primary backdrop-blur md:hidden"
      >
        <span class="sr-only">Menu</span>
        <svg
          aria-hidden="true"
          width="20"
          height="20"
          viewBox="0 0 20 20"
          fill="none"
          stroke="currentColor"
          stroke-width="1.5"
          stroke-linecap="round"
        >
          <path d="M3 7h14M3 13h14"></path>
        </svg>
      </button>
    </div>
  </div>

  <!-- Mobile menu: a frosted glass drawer that slides in from the right -->
  <dialog
    id="mobile-menu"
    aria-labelledby="mobile-menu-title"
    class="m-0 ml-auto h-dvh max-h-none w-[86%] max-w-sm rounded-l-[2rem] border-l border-white/70 bg-canvas/90 p-0 shadow-2xl backdrop-blur-xl backdrop:bg-ink/40 motion-safe:transition-transform motion-safe:duration-300 motion-safe:starting:open:translate-x-full"
  >
    <div class="flex h-full flex-col p-6">
      <div class="flex items-center justify-between">
        <p id="mobile-menu-title">
          <Logo />
          <span class="sr-only">menu</span>
        </p>
        <button
          type="button"
          data-close-menu
          class="grid size-11 place-items-center rounded-full border border-decor bg-white/70 text-primary"
        >
          <span class="sr-only">Close menu</span>
          <svg
            aria-hidden="true"
            width="20"
            height="20"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.75"
            stroke-linecap="round"
          >
            <path d="M6 6l12 12M18 6 6 18"></path>
          </svg>
        </button>
      </div>

      <nav aria-label="Main">
        <ul class="mt-10 space-y-3">
          {navLinks.map((link) => (
            <li>
              <a
                href={link.href}
                aria-current={currentPath === link.href ? 'page' : undefined}
                class="flex items-center justify-between rounded-2xl border border-white/70 bg-white/60 px-5 py-4 font-serif text-2xl text-primary aria-[current=page]:bg-surface"
              >
                {link.label}
                <ArrowIcon class="size-5" />
              </a>
            </li>
          ))}
        </ul>
      </nav>

      <a
        href="/#contact"
        class="mt-6 flex items-center justify-center gap-2 rounded-full bg-primary py-4 font-medium text-canvas shadow-lg shadow-primary/20"
      >
        Let's talk <ArrowIcon direction="up-right" />
      </a>

      <div class="mt-auto rounded-3xl bg-surface p-5">
        <p class="flex items-center gap-2 text-sm font-semibold text-ink">
          <span aria-hidden="true" class="size-2 rounded-full bg-accent"></span>
          Available for work
        </p>
        <ul class="mt-4 flex gap-3">
          {socialLinks.map((social) => (
            <li>
              <a
                href={social.href}
                class="grid size-11 place-items-center rounded-full border border-decor bg-white/70 text-primary"
              >
                <SocialIcon name={social.icon} class="size-[18px]" />
                <span class="sr-only">{social.label}</span>
              </a>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </dialog>
</header>

<script>
  const button = document.querySelector<HTMLButtonElement>('#menu-toggle');
  const dialog = document.querySelector<HTMLDialogElement>('#mobile-menu');

  if (button && dialog) {
    button.addEventListener('click', () => {
      dialog.showModal();
      button.setAttribute('aria-expanded', 'true');
      document.documentElement.style.overflow = 'hidden'; // stop the page behind from scrolling
    });

    // Runs however the dialog closes: close button, Escape, a link or the backdrop
    dialog.addEventListener('close', () => {
      button.setAttribute('aria-expanded', 'false');
      document.documentElement.style.overflow = '';
    });

    dialog.addEventListener('click', (event) => {
      const target = event.target as HTMLElement;
      const clickedBackdrop = target === dialog;
      const clickedLinkOrClose = target.closest('a, [data-close-menu]');
      if (clickedBackdrop || clickedLinkOrClose) dialog.close();
    });
  }
</script>
