---
interface Props {
  id: string;
  eyebrow: string;
  title: string;
}

const { id, eyebrow, title } = Astro.props;
---

<div>
  <p class="text-sm font-medium tracking-[0.2em] text-accent uppercase">
    {eyebrow}
  </p>
  <h2
    id={id}
    class="mt-3 font-serif text-3xl leading-tight text-primary sm:text-4xl"
  >
    {title}
  </h2>
</div>
