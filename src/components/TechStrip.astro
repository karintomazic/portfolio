---
const tools = [
  'React',
  'Next.js',
  'TypeScript',
  'Tailwind CSS',
  'Storybook',
  'Playwright',
];
---

<section
  data-reveal
  aria-labelledby="tech-heading"
  class="border-y border-decor/60 bg-white/40 backdrop-blur"
>
  <div class="mx-auto flex max-w-6xl flex-col gap-4 px-4 py-7 md:flex-row md:items-center md:gap-10">
    <h2 id="tech-heading" class="shrink-0 leading-relaxed text-ink-muted">
      I work with
    </h2>
    <ul class="flex flex-1 flex-wrap gap-x-8 gap-y-3 font-serif text-xl text-primary md:justify-between">
      {tools.map((tool) => (
        <li>{tool}</li>
      ))}
    </ul>
  </div>
</section>
