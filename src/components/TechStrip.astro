---
// Every SVG in src/assets/logos, as { '../assets/logos/react.svg': '/_astro/react.123.svg', ... }
const logoFiles = import.meta.glob<string>('../assets/logos/*.svg', {
  eager: true,
  query: '?url',
  import: 'default',
});

interface Tool {
  label: string;
  logo: string; // file name in src/assets/logos, without .svg
  height: number; // logo height in px: some logos need a little more or less to look the same size
}

// To add a tool: put its logo in src/assets/logos (e.g. scss.svg) and add a line here
const tools: Tool[] = [
  { label: 'React', logo: 'react', height: 24 },
  { label: 'Next.js', logo: 'nextjs', height: 24 },
  { label: 'TypeScript', logo: 'typescript', height: 22 },
  { label: 'Tailwind CSS', logo: 'tailwindcss', height: 16 },
  { label: 'Storybook', logo: 'storybook', height: 24 },
  { label: 'Playwright', logo: 'playwright', height: 22 },
];

function logoUrl(name: string): string {
  const url = logoFiles[`../assets/logos/${name}.svg`];
  // Fails the build with a clear message instead of showing a broken image
  if (!url) throw new Error(`Missing logo: src/assets/logos/${name}.svg`);
  return url;
}

// About 4 seconds per tool, so the speed stays the same when you add more
const duration = `${tools.length * 4}s`;
---

<section
  data-reveal
  aria-labelledby="tech-heading"
  class="border-y border-decor/60 bg-white/40 backdrop-blur"
>
  <div class="mx-auto flex max-w-6xl flex-col gap-4 px-4 py-7 md:flex-row md:items-center md:gap-10">
    <h2 id="tech-heading" class="shrink-0 leading-relaxed text-ink-muted">
      I work with
    </h2>

    <div
      class="marquee min-w-0 flex-1"
      style={`--marquee-duration: ${duration}`}
    >
      <!-- The list is there twice, so the row can loop without a gap.
           Screen readers only read the first copy (the second is aria-hidden). -->
      <div class="marquee-track">
        {[false, true].map((isCopy) => (
          <ul
            aria-hidden={isCopy ? 'true' : undefined}
            class="flex shrink-0 items-center gap-x-12 gap-y-4 pr-12 font-serif text-xl text-primary"
          >
            {tools.map((tool) => (
              <li class="flex shrink-0 items-center gap-2.5">
                <img
                  src={logoUrl(tool.logo)}
                  alt=""
                  style={`height: ${tool.height}px`}
                  class="w-auto"
                  decoding="async"
                />
                {tool.label}
              </li>
            ))}
          </ul>
        ))}
      </div>
    </div>

    <!-- Moving content needs a way to stop it (WCAG 2.2.2), not just hover.
         Hidden for people who already chose reduced motion: for them nothing moves. -->
    <button
      type="button"
      data-marquee-toggle
      aria-pressed="false"
      class="grid size-11 shrink-0 place-items-center self-end rounded-full border border-decor bg-white/70 text-primary transition-colors hover:border-primary motion-reduce:hidden md:self-auto"
    >
      <span class="sr-only">Pause scrolling logos</span>
      <svg
        data-icon="pause"
        aria-hidden="true"
        class="size-4"
        viewBox="0 0 24 24"
        fill="currentColor"
      >
        <rect x="6" y="5" width="4" height="14" rx="1"></rect>
        <rect x="14" y="5" width="4" height="14" rx="1"></rect>
      </svg>
      <svg
        data-icon="play"
        aria-hidden="true"
        class="hidden size-4"
        viewBox="0 0 24 24"
        fill="currentColor"
      >
        <path d="M8 5.5v13a1 1 0 0 0 1.5.86l10.5-6.5a1 1 0 0 0 0-1.72L9.5 4.64A1 1 0 0 0 8 5.5Z"></path>
      </svg>
    </button>
  </div>
</section>

<script>
  // Pause / play button for the logo row. aria-pressed tells screen readers
  // whether "pause" is currently on.
  document
    .querySelectorAll<HTMLButtonElement>('[data-marquee-toggle]')
    .forEach((button) => {
      const marquee =
        button.parentElement?.querySelector<HTMLElement>('.marquee');
      const pauseIcon = button.querySelector('[data-icon="pause"]');
      const playIcon = button.querySelector('[data-icon="play"]');

      button.addEventListener('click', () => {
        const paused = button.getAttribute('aria-pressed') !== 'true';
        button.setAttribute('aria-pressed', String(paused));
        marquee?.toggleAttribute('data-paused', paused);
        pauseIcon?.classList.toggle('hidden', paused);
        playIcon?.classList.toggle('hidden', !paused);
      });
    });
</script>
