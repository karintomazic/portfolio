---
import Layout from '../layouts/Layout.astro';
import ArrowIcon from '../components/ArrowIcon.astro';
---

<Layout
  title="Page not found"
  description="This page doesn't exist. Go back home or look at my projects."
>
  <section
    aria-labelledby="page-heading"
    class="mx-auto max-w-6xl px-4 pt-16 pb-32 md:pt-24"
  >
    <p
      data-intro
      style="--i: 0"
      class="text-xs font-semibold tracking-[0.2em] text-accent uppercase"
    >
      Error 404
    </p>
    <!-- prettier-ignore -->
    <h1 id="page-heading" data-intro style="--i: 1" class="mt-3 max-w-2xl font-serif text-5xl text-balance text-primary sm:text-6xl">Page not found<span aria-hidden="true" class="text-accent">.</span></h1>
    <p
      data-intro
      style="--i: 2"
      class="mt-5 max-w-xl text-lg leading-relaxed text-ink-muted"
    >
      The page you're looking for doesn't exist or has moved. Let's get you back
      on track.
    </p>

    <div data-intro style="--i: 3" class="mt-8 flex flex-wrap gap-3">
      <a
        href="/"
        class="group inline-flex items-center gap-2 rounded-full bg-primary px-6 py-3.5 font-medium text-canvas shadow-lg shadow-primary/20 transition-colors hover:bg-primary-dark"
      >
        Back to home
        <ArrowIcon class="transition-transform motion-safe:group-hover:translate-x-0.5" />
      </a>
      <a
        href="/projects"
        class="rounded-full border border-decor bg-white/70 px-6 py-3.5 font-medium text-primary backdrop-blur transition-colors hover:border-primary"
      >
        See my projects
      </a>
    </div>
  </section>
</Layout>
