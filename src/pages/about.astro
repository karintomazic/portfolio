---
// About page: sticky sidebar (photo, facts, CV) next to the story.
// The text lives in src/data/about.ts.
import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import ContactCta from '../components/ContactCta.astro';
import ArrowIcon from '../components/ArrowIcon.astro';
import portrait from '../assets/karin.png';
import {
  intro,
  facts,
  story,
  outsideWork,
  hobbies,
  experience,
} from '../data/about';
---

<Layout
  title="About"
  description="About Karin Tomazic: frontend developer from Maribor, Slovenia, building accessible, well-tested interfaces with React, Next.js and TypeScript."
>
  <section
    aria-labelledby="page-heading"
    class="mx-auto max-w-6xl px-4 pt-10 pb-24 md:pt-16"
  >
    <p
      data-intro
      style="--i: 0"
      class="text-xs font-semibold tracking-[0.2em] text-accent uppercase"
    >
      About
    </p>
    <!-- prettier-ignore -->
    <h1 id="page-heading" data-intro style="--i: 1" class="mt-3 max-w-2xl font-serif text-5xl text-balance text-primary sm:text-6xl">About me<span aria-hidden="true" class="text-accent">.</span></h1>
    <p
      data-intro
      style="--i: 2"
      class="mt-5 max-w-xl text-lg leading-relaxed text-ink-muted"
    >
      {intro}
    </p>

    <div class="mt-14 grid gap-12 md:grid-cols-[18rem_1fr] lg:gap-20">
      <!-- Sidebar -->
      <aside aria-label="Quick facts" class="md:sticky md:top-8 md:self-start">
        <div
          data-intro
          style="--i: 3"
          data-glass
          class="relative rounded-[2rem] border border-white/70 bg-white/60 p-6 backdrop-blur"
        >
          <div class="mx-auto aspect-square w-40 overflow-hidden rounded-full bg-linear-to-br from-surface to-surface-alt">
            <Image
              src={portrait}
              alt="Karin Tomazic smiling"
              widths={[160, 320]}
              sizes="160px"
              class="size-full object-cover object-[50%_20%]"
            />
          </div>
          <dl class="mt-6 grid grid-cols-2 gap-x-6 gap-y-4 md:grid-cols-1">
            {facts.map((fact) => (
              <div class="flex flex-col-reverse border-t border-decor pt-4">
                <dt class="text-sm text-ink-muted">{fact.label}</dt>
                <dd class="font-serif text-2xl text-primary">{fact.value}</dd>
              </div>
            ))}
          </dl>
          <a
            href="/karin-tomazic-cv.pdf"
            class="group mt-6 flex items-center gap-3 border-t border-decor pt-4 text-sm font-semibold text-primary"
          >
            <span class="grid size-9 place-items-center rounded-full border border-decor transition-colors group-hover:bg-primary group-hover:text-canvas">
              <ArrowIcon direction="down" />
            </span>
            Download CV <span class="sr-only">(PDF)</span>
          </a>
        </div>
      </aside>

      <!-- Story -->
      <div class="max-w-2xl">
        {story.map((section) => (
          <div data-reveal class="mb-12">
            <h2 class="font-serif text-3xl text-primary">{section.heading}</h2>
            {section.paragraphs.map((text) => (
              <p class="mt-4 text-lg leading-relaxed text-ink-muted">{text}</p>
            ))}
          </div>
        ))}

        <div data-reveal class="mb-12">
          <h2 class="font-serif text-3xl text-primary">Outside of work</h2>
          <p class="mt-4 text-lg leading-relaxed text-ink-muted">
            {outsideWork}
          </p>
          <ul class="mt-5 flex flex-wrap gap-2" aria-label="Hobbies">
            {hobbies.map((hobby) => (
              <li class="rounded-full border border-decor bg-white/70 px-4 py-1.5 text-sm text-primary">
                {hobby}
              </li>
            ))}
          </ul>
        </div>

        <div data-reveal>
          <h2 class="font-serif text-3xl text-primary">Experience</h2>
          <ol class="mt-6 border-l-2 border-decor">
            {experience.map((job) => (
              <li class="relative pb-8 pl-8 last:pb-0">
                <span
                  aria-hidden="true"
                  class="absolute top-1.5 -left-[7px] size-3 rounded-full bg-accent ring-4 ring-canvas"
                />
                <p class="text-sm font-semibold text-accent">{job.years}</p>
                <h3 class="mt-1 font-serif text-xl text-primary">{job.role}</h3>
                <p class="text-ink-muted">{job.place}</p>
              </li>
            ))}
          </ol>
        </div>
      </div>
    </div>
  </section>

  <ContactCta />
</Layout>
