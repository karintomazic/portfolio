---
import Layout from '../../layouts/Layout.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import ContactCta from '../../components/ContactCta.astro';
import { getProjects } from '../../data/projects';

const projects = await getProjects();
---

<Layout
  title="Work"
  description="Selected projects by Karin Tomazic: client websites and web apps built with React, Next.js and TypeScript."
>
  <section
    aria-labelledby="page-heading"
    class="mx-auto max-w-6xl px-4 pt-10 pb-24 md:pt-16"
  >
    <p
      data-intro
      style="--i: 0"
      class="text-xs font-semibold tracking-[0.2em] text-accent uppercase"
    >
      Work
    </p>
    <!-- prettier-ignore -->
    <h1 id="page-heading" data-intro style="--i: 1" class="mt-3 max-w-2xl font-serif text-5xl text-balance text-primary sm:text-6xl">Projects I've built<span aria-hidden="true" class="text-accent">.</span></h1>
    <p
      data-intro
      style="--i: 2"
      class="mt-5 max-w-xl leading-relaxed text-ink-muted"
    >
      Client websites and web apps, each with a short case study: what I built,
      the decisions behind it, and how I tested it.
    </p>

    <ul class="mt-14 grid gap-6 md:grid-cols-2 lg:grid-cols-3">
      {projects.map((project, index) => (
        <li data-reveal style={`--i: ${index}`}>
          <ProjectCard project={project} headingLevel="h2" />
        </li>
      ))}
    </ul>
  </section>

  <ContactCta />
</Layout>
